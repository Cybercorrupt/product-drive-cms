APP_NAME="Product Drive CMS"
APP_URL=http://localhost/product-drive-cms/public
APP_ENV=local
APP_KEY=change-this-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=product_drive
DB_USERNAME=root
DB_PASSWORD=

# Google Drive OAuth (Google Cloud > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/product-drive-cms/public/google/callback.php
GOOGLE_DRIVE_ROOT_FOLDER_NAME="Product Drive"

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v24.0

WHATSAPP_DEFAULT_PHOTO_COUNT=1
WHATSAPP_MAX_PHOTO_COUNT=10
WHATSAPP_MAX_UPLOAD_PHOTO_COUNT=50

WHATSAPP_DEFAULT_VIDEO_COUNT=1
WHATSAPP_MAX_VIDEO_COUNT=10
